# ═══════════════════════════════════════════════════════════════
#  Jovia Network — .htaccess (Apache)
#  Canonical origin: https://joviaplatform.ng (HTTPS, no www)
# ═══════════════════════════════════════════════════════════════

Options -Indexes
RewriteEngine On

# ── 1. Force HTTPS ──
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── 2. Force non-www ──
RewriteCond %{HTTP_HOST} ^www\.joviaplatform\.ng$ [NC]
RewriteRule ^ https://joviaplatform.ng%{REQUEST_URI} [R=301,L]

# ── 3. /index.html → / ──
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ── 4. Extensionless URLs → .html (e.g. /signup → /signup.html) ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z-]+)/?$ /$1.html [R=301,L]

# ── 5. Block hidden files and archives ──
RewriteRule (^|/)\. - [F]
<FilesMatch "\.(zip|env|log|bak|sql)$">
  Require all denied
</FilesMatch>

# ── 6. Security headers ──
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 7. Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml text/plain
</IfModule>

# ── 8. Caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

AddType application/manifest+json .webmanifest
